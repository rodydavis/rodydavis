{
  "name": "Rody Davis",
  "short_name": "Rody Davis",
  "description": "Rody Davis's personal website, engineering blog, and portfolio.",
  "start_url": "/",
  "scope": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#1e1e1e",
  "theme_color": "#007acc",
  "categories": ["developer", "education", "technology", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Hybrid Vector Search",
      "short_name": "Search",
      "description": "Search posts, code, images, and videos",
      "url": "/search",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Browse Tags",
      "short_name": "Tags",
      "description": "Explore posts by topic tag",
      "url": "/tags",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Workbench Settings",
      "short_name": "Settings",
      "description": "Customize VS Code color theme",
      "url": "/settings",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
