---
import { getEntry } from "astro:content";
import ExplorerLayout from "../../layouts/ExplorerLayout.astro";

let { slug } = Astro.params;

if (slug === undefined) {
    return Astro.redirect("/editor/welcome");
}

const doc = await getEntry("docs", slug);

if (!doc) {
    return Astro.redirect("/404");
}
---

<ExplorerLayout
    activePostId={doc.id}
    title={doc.data.title}
    code={doc.body}
    tabs={doc.data.tabs}
    viewMode="editor"
/>
